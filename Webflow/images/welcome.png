<script>
  (function() {
    const savedMode = localStorage.getItem("darkMode");
    let prefersDark;
    if (savedMode !== null) {
      prefersDark = savedMode === "true";
    } else {
      prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    }
    document.documentElement.classList.toggle("u-mode-dark", prefersDark);
  })();
</script>
